{
  "name": "webdevops/dockerfile",
  "license": "MIT",
  "type": "project",
  "authors": [
    {
      "name": "Hans Tuscher",
      "email": "hhoechtl@1drop.de"
    }
  ],
  "require": {
    "php": "^8.4",
    "bluem/tree": "^4.0",
    "symfony/console": "^6.0",
    "symfony/process": "^6.0",
    "symfony/yaml": "^6.0",
    "twig/twig": "^3.22"
  },
  "require-dev": {
    "phpunit/phpunit": "^12",
    "pluswerk/grumphp-config": "^11.2"
  },
  "autoload": {
    "psr-4": {
      "Webdevops\\Build\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Webdevops\\Build\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "a9f/fractor-extension-installer": true,
      "ergebnis/composer-normalize": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "pluswerk/grumphp-config": true
    }
  },
  "extra": {
    "grumphp": {
      "disable-plugin": true
    }
  }
}
