#!/usr/bin/env php
<?php

require __DIR__ . '/vendor/autoload.php';

use Symfony\Component\Console\Application;
use Webdevops\Build\Commands\BuildGlyphsCommand;
use Webdevops\Build\Commands\GenerateCommand;
use Webdevops\Build\Commands\GenerateDockerfileCommand;
use Webdevops\Build\Commands\GenerateGithubCiCommand;
use Webdevops\Build\Commands\GenerateProvisionCommand;
use Webdevops\Build\Commands\GenerateReadmeBannerCommand;
use Webdevops\Build\Commands\TestImageCommand;

$application = new Application();

$application->add(new GenerateCommand());
$application->add(new GenerateDockerfileCommand());
$application->add(new GenerateProvisionCommand());
$application->add(new GenerateGithubCiCommand());
$application->add(new GenerateReadmeBannerCommand());
$application->add(new BuildGlyphsCommand());
$application->add(new TestImageCommand());

$application->run();
