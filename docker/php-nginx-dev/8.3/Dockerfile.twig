{% import 'docker.twig' as docker %}
{% import 'provision.twig' as provision %}
{% import 'environment.twig' as environment %}
{% import 'images/php.twig' as php %}
{{ docker.from("php-nginx", "8.3") }}

{{ environment.web() }}
{{ environment.webPhp() }}
{{ environment.webDevelopment() }}

{{ docker.copy('conf/', '/opt/docker/') }}

RUN --mount=type=bind,from=ghcr.io/php/pie:bin,source=/pie,target=/usr/local/bin/pie \
    set -x \
    {{ php.officialDevelopment(version="8.3") }} \
    {{ provision.runBootstrap() }} \
    {{ docker.cleanup() }}
