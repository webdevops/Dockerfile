{% import 'docker.twig' as docker %}
{% import 'provision.twig' as provision %}
{% import 'environment.twig' as environment %}
{% import 'images/nginx.twig' as nginx %}
{{ docker.from("php", "8.5") }}

{{ environment.web() }}
{{ environment.webPhp() }}
{{ environment.nginx() }}

{{ docker.copy('conf/', '/opt/docker/') }}

RUN set -x \
    {{ nginx.debian() }} \
    {{ provision.runBootstrap() }} \
    {{ docker.cleanup() }}

{{ docker.expose('80 443') }}
