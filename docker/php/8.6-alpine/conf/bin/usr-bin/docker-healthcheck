#!/usr/bin/env bash
# Checks the services of supervisord, for a HEALTHCHECK of Docker or a healthcheck in compose.yaml.
#
# Unhealthy (exit code 1): a service that supervisord gave up on (FATAL), that it is restarting after a failed start
# (BACKOFF) or whose state it does not know (UNKNOWN), and a supervisord that does not answer. The lines of those
# services are printed.
# Healthy (exit code 0): services that run or start (RUNNING, STARTING), that are not enabled or were stopped (STOPPED)
# and that ended (EXITED): supervisorctl status does not say whether a service ended as expected, and the services of
# the images are restarted when they end. supervisorctl status itself ends with an error as soon as a service is
# STOPPED, so only the states count.
#
# Docker keeps the output of a check only in docker inspect, so each failed check also writes its reason to the
# container log (docker logs), through the stderr of supervisord (PID 1), and the first check that passes after one
# that failed writes "healthy again" there.

set -o pipefail

CONTAINER_LOG=/proc/1/fd/2
FAILED_MARKER=/run/docker-healthcheck.failed

# Writes $1 to the container log, each line with the prefix "docker-healthcheck: "; without the permission to (not
# root), the check itself still counts
containerLog() {
    { sed 's/^/docker-healthcheck: /' <<<"$1" > "$CONTAINER_LOG"; } 2>/dev/null || true
}

unhealthy() {
    echo "$1"
    containerLog "unhealthy: $1"
    { : > "$FAILED_MARKER"; } 2>/dev/null || true
    exit 1
}

status=$(supervisorctl status 2>&1)

if ! grep -qE '^\S+\s+(RUNNING|STARTING|STOPPED|STOPPING|EXITED|BACKOFF|FATAL|UNKNOWN)\b' <<<"$status"; then
    unhealthy "supervisord does not answer:
$status"
fi

failed=$(grep -E '^\S+\s+(FATAL|BACKOFF|UNKNOWN)\b' <<<"$status")
if [[ -n "$failed" ]]; then
    unhealthy "$failed"
fi

if [[ -e "$FAILED_MARKER" ]] && rm -f "$FAILED_MARKER" 2>/dev/null; then
    containerLog "healthy again"
fi

exit 0
