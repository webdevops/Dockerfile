{% import 'Dockerfile/docker.jinja2' as docker %}
{% import 'Dockerfile/provision.jinja2' as provision %}

{% macro alpine(role='') -%}
    # Install nginx
    && apk-install \
        nginx
{%- endmacro %}


{% macro centos(role='') -%}
    # Install tools
    && yum-install \
        nginx
{%- endmacro %}

{% macro debian(role='') -%}
    # Install nginx
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL https://nginx.org/keys/nginx_signing.key -o /etc/apt/keyrings/nginx.asc \
    && printf "deb [signed-by=/etc/apt/keyrings/nginx.asc] http://nginx.org/packages/debian/ $(docker-image-info dist-codename) nginx\n" \
    > /etc/apt/sources.list.d/nginx.list \
    && apt-install \
    nginx
{%- endmacro %}


{% macro ubuntu(role='') -%}
    # Install nginx
    && apt-install \
        nginx
{%- endmacro %}
