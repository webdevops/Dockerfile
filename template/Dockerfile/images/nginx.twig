{% macro alpine(role='') -%}
    # Install nginx
    && apk-install \
        nginx
{%- endmacro %}

{% macro debian(role='') -%}
    # Install nginx
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 https://nginx.org/keys/nginx_signing.key -o /etc/apt/keyrings/nginx.asc \
    && printf "deb [signed-by=/etc/apt/keyrings/nginx.asc] https://nginx.org/packages/debian/ $(docker-image-info dist-codename) nginx\n" \
    > /etc/apt/sources.list.d/nginx.list \
    && apt-install \
    nginx
{%- endmacro %}
