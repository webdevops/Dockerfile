{% macro official(role='', version='', distribution='') -%}
{% import 'services.twig' as services -%}
{% import 'images/php-extensions.twig' as extensions -%}
    # Install php environment
    && apt-install \
        # Install tools
        file \
        imagemagick \
        graphicsmagick \
        ghostscript \
        jpegoptim \
        libjpeg-turbo-progs \
        pngcrush \
        optipng \
        apngopt \
        pngnq \
        pngquant \
        # Libraries
{% if distribution == 'trixie' %}
        libavif16 \
        libvips42t64 \
        libldap2 \
        libpng16-16t64 \
        libzip5 \
        libmemcached11t64 \
{% else %}
        libavif15 \
        libvips42 \
        libldap-2.5-0 \
        libpng16-16 \
        libzip4 \
        libmemcached11 \
{% endif %}
        librabbitmq4 \
        libxslt1.1 \
        libldap-common \
        zlib1g \
        libpq5 \
        libmcrypt4 \
        libyaml-0-2 \
        libonig5 \
{% if version == '8.2' or version == '8.3' %}
        libc-client2007e \
        libc-client-dev \
        libc-client2007e-dev \
{% endif %}
        # Dev and headers
        libavif-dev \
        libjpeg62-turbo-dev \
        libwebp-dev \
        libfreetype-dev \
        libbz2-dev \
        libicu-dev \
        libldap2-dev \
        libldb-dev \
        libmcrypt-dev \
        libxml2-dev \
        libxslt1-dev \
        zlib1g-dev \
        libmemcached-dev \
        libpng-dev \
        libpq-dev \
        libzip-dev \
        libkrb5-dev \
        libvips-dev \
        librabbitmq-dev \
        libmagick++-dev \
        libgmp-dev \
        libyaml-dev \
        libssl-dev \
        libonig-dev \
    # Install guetzli
    && wget https://github.com/google/guetzli/archive/master.zip \
    && unzip master.zip \
    && make -C guetzli-master \
    && cp guetzli-master/bin/Release/guetzli /usr/local/bin/ \
    && rm -rf master.zip guetzli-master \
    # Install new version of ICU
    && curl -sS -o /tmp/icu.tar.gz -L https://github.com/unicode-org/icu/releases/download/release-73-1/icu4c-73_1-src.tgz \
    && tar -zxf /tmp/icu.tar.gz -C /tmp && cd /tmp/icu/source && ./configure --prefix=/usr/local && make -j"$(nproc)" && make install && cd / && rm -rf /tmp/icu* \
    # Install extensions
    && PKG_CONFIG_PATH=/usr/local docker-php-ext-configure intl \
    && docker-php-ext-configure gd --with-avif --with-jpeg --with-freetype --with-webp \
    && git clone --branch latest --depth 1 https://github.com/php-amqp/php-amqp.git /usr/src/php/ext/amqp \
    {{ extensions.amqpCheckout(version) }} \
    && git clone --branch master --depth 1 https://github.com/Imagick/imagick.git /usr/src/php/ext/imagick \
    && docker-php-ext-configure ldap \
{% if version == '8.2' or version == '8.3' %}
    && docker-php-ext-configure ftp --with-openssl-dir \
{% elseif version == '8.4' or version == '8.5' or version == '8.6' %}
    && docker-php-ext-configure ftp --with-ftp-ssl \
{% endif %}
{% if version != '8.4' and version != '8.5' and version != '8.6' %}
    && PHP_OPENSSL=yes docker-php-ext-configure imap --with-kerberos --with-imap-ssl \
{% endif %}
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        amqp \
        imagick \
        ffi \
        bz2 \
        calendar \
        exif \
        ftp \
        gmp \
        intl \
        gettext \
        ldap \
        mysqli \
{% if version == '8.6' %}
        mbstring \
{% endif %}
{% if version != '8.4' and version != '8.5' and version != '8.6' %}
        imap \
{% endif %}
        pcntl \
        pdo_mysql \
        pdo_pgsql \
        pgsql \
        soap \
        sockets \
        sysvmsg \
        sysvsem \
        sysvshm \
        shmop \
        xsl \
        zip \
        gd \
{% if version != '8.5' and version != '8.6' %}
        opcache \
{% endif %}
    {{ extensions.external(version) }} \
    && echo extension=apcu.so > /usr/local/etc/php/conf.d/apcu.ini \
    && echo extension=excimer.so > /usr/local/etc/php/conf.d/excimer.ini \
    && echo extension=opentelemetry.so > /usr/local/etc/php/conf.d/opentelemetry.ini \
    && echo extension=protobuf.so > /usr/local/etc/php/conf.d/protobuf.ini \
    && echo extension=redis.so > /usr/local/etc/php/conf.d/redis.ini \
    && echo extension=mongodb.so > /usr/local/etc/php/conf.d/mongodb.ini \
    && echo extension=memcached.so > /usr/local/etc/php/conf.d/memcached.ini \
    && echo extension=yaml.so > /usr/local/etc/php/conf.d/yaml.ini \
{% if version != '8.6' %}
    && echo extension=vips.so > /usr/local/etc/php/conf.d/vips.ini \
    && echo extension=xmlrpc.so > /usr/local/etc/php/conf.d/xmlrpc.ini \
{% endif %}
    # Uninstall dev and header packages
    && apt-get purge -y -f --force-yes \
{% if version == '8.2' or version == '8.3' %}
        libc-client-dev \
        libc-client2007e-dev \
{% endif %}
        libkrb5-dev \
        libbz2-dev \
        libavif-dev \
        libicu-dev \
        libldap2-dev \
        libldb-dev \
        libmcrypt-dev \
        libxml2-dev \
        libxslt1-dev \
        zlib1g-dev \
        libpng-dev \
        libwebp-dev \
        libpq-dev \
        libzip-dev \
        libvips-dev \
        librabbitmq-dev \
        libmagick++-dev \
        libgmp-dev \
        libyaml-dev \
        libssl-dev \
        libonig-dev \
    && rm -f /usr/local/etc/php-fpm.d/zz-docker.conf \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin/ --filename=composer2 \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin/ --filename=composer1 --1 \
    && ln -sf /usr/local/bin/composer2 /usr/local/bin/composer \
    {{ services.php() }}
{%- endmacro %}

{% macro officialAlpine(role='', version='') -%}
{% import 'services.twig' as services -%}
{% import 'images/php-extensions.twig' as extensions -%}
    # Install php environment
    && apk-install \
        file \
        imagemagick \
        graphicsmagick \
        ghostscript \
        jpegoptim \
        pngcrush \
        optipng \
        pngquant \
        vips \
        rabbitmq-c \
        c-client \
        # Libraries
        libavif \
        libldap \
        icu-libs \
        libintl \
        libpq \
        libxslt \
        libgomp \
        libzip \
        libmemcached \
        yaml \
        oniguruma \
        # Build dependencies
        linux-headers \
        autoconf \
        g++ \
        make \
        libtool \
        pcre-dev \
        gettext-dev \
        libavif-dev \
        freetype-dev \
        gmp-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        vips-dev \
        krb5-dev \
        openssl-dev \
        imap-dev \
        imagemagick-dev \
        rabbitmq-c-dev \
        openldap-dev \
        icu-dev \
        postgresql-dev \
        libxml2-dev \
        samba-dev \
        pcre-dev \
        libxslt-dev \
        libzip-dev \
        libmemcached-dev \
        yaml-dev \
        oniguruma-dev \
    # Install guetzli
    && wget https://github.com/google/guetzli/archive/master.zip \
    && unzip master.zip \
    && make -C guetzli-master \
    && cp guetzli-master/bin/Release/guetzli /usr/local/bin/ \
    && rm -rf master.zip guetzli-master \
    # https://github.com/docker-library/php/issues/240
    && apk add gnu-libiconv --update-cache --repository http://dl-cdn.alpinelinux.org/alpine/edge/testing/ --allow-untrusted \
    # Install new version of ICU
    && curl -sS -o /tmp/icu.tar.gz -L https://github.com/unicode-org/icu/releases/download/release-73-1/icu4c-73_1-src.tgz \
    && tar -zxf /tmp/icu.tar.gz -C /tmp && cd /tmp/icu/source && ./configure --prefix=/usr/local && make -j"$(nproc)" && make install && cd / && rm -rf /tmp/icu* \
    # Install extensions
    && PKG_CONFIG_PATH=/usr/local docker-php-ext-configure intl \
    && docker-php-ext-configure gd --with-avif --with-jpeg --with-freetype --with-webp \
    && git clone --branch master --depth 1 https://github.com/Imagick/imagick.git /usr/src/php/ext/imagick \
    && git clone --branch latest --depth 1 https://github.com/php-amqp/php-amqp.git /usr/src/php/ext/amqp \
    {{ extensions.amqpCheckout(version) }} \
    && docker-php-ext-configure ldap \
{% if version == '8.2' or version == '8.3' %}
    && docker-php-ext-configure ftp --with-openssl-dir \
{% elseif version == '8.4' or version == '8.5' or version == '8.6' %}
    && docker-php-ext-configure ftp --with-ftp-ssl \
{% endif %}
{% if version != '8.4' and version != '8.5' and version != '8.6' %}
    && PHP_OPENSSL=yes docker-php-ext-configure imap --with-kerberos --with-imap-ssl \
{% endif %}
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        bz2 \
        calendar \
        exif \
        ftp \
        gmp \
        ffi \
        imagick \
        amqp \
        intl \
        gettext \
        ldap \
        mysqli \
{% if version == '8.6' %}
        mbstring \
{% endif %}
{% if version != '8.4' and version != '8.5' and version != '8.6' %}
        imap \
{% endif %}
        pcntl \
        pdo_mysql \
        pdo_pgsql \
        pgsql \
        soap \
        sockets \
        sysvmsg \
        sysvsem \
        sysvshm \
        shmop \
        xsl \
        zip \
        gd \
{% if version != '8.5' and version != '8.6' %}
        opcache \
{% endif %}
    {{ extensions.external(version) }} \
    && docker-php-ext-enable \
        apcu \
        excimer \
        opentelemetry \
        protobuf \
        yaml \
        redis \
        imagick \
        mongodb \
        memcached \
{% if version != '8.6' %}
        vips \
        xmlrpc \
{% endif %}
    # Uninstall dev and header packages
    && apk del -f --purge \
        autoconf \
        linux-headers \
        g++ \
        make \
        libtool \
        pcre-dev \
        gettext-dev \
        libavif-dev \
        freetype-dev \
        gmp-dev \
        libjpeg-turbo-dev \
        libpng-dev \
        vips-dev \
        krb5-dev \
        openssl-dev \
        imap-dev \
        rabbitmq-c-dev \
        imagemagick-dev \
        openldap-dev \
        icu-dev \
        postgresql-dev \
        libxml2-dev \
        samba-dev \
        pcre-dev \
        libxslt-dev \
        libzip-dev \
        libmemcached-dev \
        yaml-dev \
        oniguruma-dev \
    && rm -f /usr/local/etc/php-fpm.d/zz-docker.conf \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin/ --filename=composer2 \
    && curl -sS https://getcomposer.org/installer | php -- --install-dir=/usr/local/bin/ --filename=composer1 --1 \
    && ln -sf /usr/local/bin/composer2 /usr/local/bin/composer \
    {{ services.php() }}
{%- endmacro %}

{% macro officialDevelopment(role='', version='') -%}
{% import 'services.twig' as services -%}
{% import 'images/php-extensions.twig' as extensions -%}
    # Install development environment
    && BLACKFIRE_INSTALL_METHOD=raw bash -c "$(curl -L https://installer.blackfire.io/installer.sh)" \
    && blackfire php:install \
{% if version == '8.6' %}
    # TODO PHP 8.6: Tideways is not installed yet, tideways-php 5.47.0 crashes
    # PHP 8.6.0RC4 (ZTS) on startup
{% else %}
    && install -d -m 0755 /etc/apt/keyrings \
    && curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 https://packages.tideways.com/key.gpg -o /etc/apt/keyrings/tideways.asc \
    && echo 'deb [signed-by=/etc/apt/keyrings/tideways.asc] https://packages.tideways.com/apt-packages-main any-version main' | tee /etc/apt/sources.list.d/tideways.list \
    && apt-install tideways-php tideways-daemon \
{% endif %}
    && PIE_WORKING_DIRECTORY=/tmp/pie pie install --no-interaction --no-cache \
        --skip-enable-extension --make-parallel-jobs="$(nproc)" {{ extensions.xdebug(version) }} \
    && rm -rf /tmp/pie \
    && docker-php-ext-enable xdebug \
    {{ services.phpDev() }}
{%- endmacro %}

{% macro officialDevelopmentAlpine(role='', version='') -%}
{% import 'services.twig' as services -%}
{% import 'images/php-extensions.twig' as extensions -%}
    # Install development environment
    && bash -c "$(curl -L https://installer.blackfire.io/installer.sh)" \
{% if version == '8.6' %}
    # TODO PHP 8.6: `blackfire php:install` installs the glibc probe on Alpine with ZTS;
    # install the Alpine probe directly
    && mkdir -p /tmp/blackfire \
    && curl -fsSL --proto '=https' --proto-redir '=https' --retry 3 "https://blackfire.io/api/v1/releases/probe/php/alpine/$(uname -m | sed 's/x86_64/amd64/;s/aarch64/arm64/')/86-zts" | tar xz -C /tmp/blackfire \
    && mv /tmp/blackfire/blackfire-*.so "$(php -r 'echo ini_get("extension_dir");')/blackfire.so" \
    && printf '[blackfire]\nextension=blackfire.so\n' > /usr/local/etc/php/conf.d/99-blackfire.ini \
    && rm -rf /tmp/blackfire \
{% else %}
    && blackfire php:install \
{% endif %}
    && apk-install \
        linux-headers \
        make \
        autoconf \
        g++ \
        libtool \
        pkgconf \
    && PIE_WORKING_DIRECTORY=/tmp/pie pie install --no-interaction --no-cache \
        --skip-enable-extension --make-parallel-jobs="$(nproc)" {{ extensions.xdebug(version) }} \
    && rm -rf /tmp/pie \
    && apk del -f --purge \
        autoconf \
        linux-headers \
        g++ \
        make \
        libtool \
        pkgconf \
    && docker-php-ext-enable xdebug \
    {{ services.phpDev() }}
{%- endmacro %}
